{
  "packageRules": [
    {
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Update APK packages in Dockerfile RUN statements with HEREDOC",
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^Dockerfile\\.[^/]*$"],
      
      "matchStrings": [
        "apk\\s+add\\s+(?:--[^\\s]+\\s+)*(?<depName>[a-z0-9][a-z0-9._+-]*)=(?<currentValue>\\d+[^\\s]*)(?:\\s|$)"
      ],
      
      "datasourceTemplate": "apk",
      "versioningTemplate": "apk"
    }
  ]
}
